# Replace ${PROJECT_ID}, ${REGION}, ${POLICY_NAME}, ${EXTENSION_NAME}, and ${FORWARDING_RULE_URI}
# Regional Forwarding Rule URI format:
#   https://www.googleapis.com/compute/v1/projects/${PROJECT_ID}/regions/${REGION}/forwardingRules/${FORWARDING_RULE_NAME}
# Global Forwarding Rule URI format (when using Global External ALB in location=global):
#   https://www.googleapis.com/compute/v1/projects/${PROJECT_ID}/global/forwardingRules/${FORWARDING_RULE_NAME}
# Import with:
#   gcloud network-security authz-policies import "${POLICY_NAME}" \
#     --project="${PROJECT_ID}" --location="${REGION}" --source=authz-policy.yaml
name: projects/${PROJECT_ID}/locations/${REGION}/authzPolicies/${POLICY_NAME}
action: CUSTOM
policyProfile: CONTENT_AUTHZ
customProvider:
  authzExtension:
    resources:
    - projects/${PROJECT_ID}/locations/${REGION}/authzExtensions/${EXTENSION_NAME}
target:
  loadBalancingScheme: EXTERNAL_MANAGED
  resources:
  - ${FORWARDING_RULE_URI}
